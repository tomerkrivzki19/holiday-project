pipeline {
    agent any

    environment {
        IMAGE_NAME = 'holiday-app'
        DOCKERHUB_CREDENTIALS = 'dockerhub-credentials'
        TEST_PORT = '3001'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Test Application') {
            steps {
                sh '''
                    node --check server.js

                    PORT=${TEST_PORT} node server.js > application.log 2>&1 &
                    APP_PID=$!

                    cleanup() {
                        kill "$APP_PID" 2>/dev/null || true
                    }

                    trap cleanup EXIT

                    sleep 5
                    curl --fail http://localhost:${TEST_PORT}/health
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .'
            }
        }

        stage('Tag Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKERHUB_CREDENTIALS}",
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        docker tag \
                          ${IMAGE_NAME}:${BUILD_NUMBER} \
                          ${DOCKERHUB_USERNAME}/${IMAGE_NAME}:${BUILD_NUMBER}

                        docker tag \
                          ${IMAGE_NAME}:${BUILD_NUMBER} \
                          ${DOCKERHUB_USERNAME}/${IMAGE_NAME}:latest
                    '''
                }
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKERHUB_CREDENTIALS}",
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        echo "$DOCKERHUB_TOKEN" |
                          docker login \
                            --username "$DOCKERHUB_USERNAME" \
                            --password-stdin

                        docker push \
                          ${DOCKERHUB_USERNAME}/${IMAGE_NAME}:${BUILD_NUMBER}

                        docker push \
                          ${DOCKERHUB_USERNAME}/${IMAGE_NAME}:latest
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
            echo 'Docker image was published to Docker Hub.'
        }

        failure {
            echo 'Pipeline failed. Review the console output.'
            sh 'test -f application.log && cat application.log || true'
        }

        always {
            sh 'docker logout || true'
            deleteDir()
        }
    }
}